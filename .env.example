# Public URL of the app (used in e-mails and OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (values for local development come from `supabase status`)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Language shown until a user picks another one (en or sl). Unset: follow the browser language.
DEFAULT_LOCALE=

# Shown in the privacy policy and terms of use (/privacy, /terms)
OPERATOR_NAME=
OPERATOR_EMAIL=

# Serve a single municipality: "/" opens it, other municipalities return 404 (slug, optional)
SINGLE_MUNICIPALITY=

# Comma-separated OAuth providers enabled in Supabase Auth: google,facebook,apple,azure
NEXT_PUBLIC_AUTH_PROVIDERS=google,facebook
# Show e-mail + password sign-in (handy for demo accounts in development)
NEXT_PUBLIC_ENABLE_PASSWORD_LOGIN=false
# Demo credentials shown as a hint on /login (the hint is skipped when unset)
NEXT_PUBLIC_DEMO_LOGIN_EMAIL=
NEXT_PUBLIC_DEMO_LOGIN_PASSWORD=

# Map style (any MapLibre style URL). Default: OpenFreeMap Positron (free, no key)
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# Raster tiles for the satellite map style ({z}/{y}/{x} or {z}/{x}/{y}); defaults to Esri World Imagery.
# NEXT_PUBLIC_SATELLITE_TILES_URL=

# Outgoing e-mail via SMTP (any provider, e.g. Resend, Postmark, SES).
# Local Supabase ships Mailpit: smtp://127.0.0.1:54325, inbox at http://127.0.0.1:54324
SMTP_URL=smtp://127.0.0.1:54325
EMAIL_FROM="OpenCityVoice <no-reply@opencityvoice.local>"
